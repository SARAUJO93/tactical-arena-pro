    $('btnCloseTelemetry').addEventListener('click', () => this.toggleTelemetry());$('obsAudioUnlock').addEventListener('click', () => synth.unlock());

    // Controles generales
    $('btnQuickDemo').addEventListener('click', () => this.toggleDemoMode());$('btnDemoToggle').addEventListener('click', () => this.toggleDemoMode());
    $('btnQuickSafe').addEventListener('click', () => this.toggleSafeZones());$('btnSafeToggle').addEventListener('click', () => this.toggleSafeZones());

    const toggleAudio = () => {
      state.audioEnabled = !state.audioEnabled;
      this.syncControlButtons();
