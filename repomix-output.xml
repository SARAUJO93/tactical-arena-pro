  private bindEvents(): void {
    const { synth, tikfinity } = this.deps;

    // Barra superior y modales
    $('btnOpenPanel').addEventListener('click', () => this.togglePanel());$('btnClosePanel').addEventListener('click', () => this.togglePanel());
