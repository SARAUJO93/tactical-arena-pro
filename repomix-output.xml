          <div class="section-title">
            <span style="color:#A78BFA;">🚀 Música de Fondo (0% Copyright + Ducking)</span>
            <span id="bpmBadge" class="tabular" style="color:#34D399;">138 BPM</span>
          </div>
          <select id="selMusicMode" class="sel" style="margin-bottom:8px;">
            <option value="starfox">🚀 Star Fox Synth (Sin Copyright)</option>
            <option value="pulse">⚡ Pulso Táctico</option>
            <option value="mp3">📁 MP3 Propio</option>
            <option value="off">🔇 Silencio</option>
          </select>
          <div style="display:flex;gap:6px;align-items:center;margin-bottom:7px;">
            <span style="font-size:9.5px;color:#CBD5E1;white-space:nowrap;">Volumen Música</span>
            <input id="sliderMusicVol" type="range" min="5" max="100" step="5" value="35" style="flex:1;" />
            <strong id="lblMusicVol" class="tabular" style="font-size:9.5px;width:32px;text-align:right;">35%</strong>
          </div>
          <div id="mp3UploadRow" style="display:flex;gap:6px;align-items:center;">
            <label class="btn btn-primary" style="flex:1;text-align:center;font-size:10px;cursor:pointer;">
              📁 Cargar .MP3 / .OGG Local
              <input id="inMusicFile" type="file" accept="audio/*" class="hidden" />
            </label>
          </div>
          <div id="musicTrackLabel" style="font-size:8.8px;color:#94A3B8;margin-top:5px;">
            Activo: Secuenciador Star Fox Synth (+18% BPM en Muerte Súbita, ducking al 20% en alertas).
          </div>
        </div>

        <div class="section-card" style="border-color:rgba(251,113,133,0.32);">
          <div class="section-title">
            <span style="color:#FDA4AF;">❤️ Configuración de Tap Tap (Likes)</span>
            <span style="color:#94A3B8;">Teclas T / Y / Space</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
            <div>
              <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:3px;">
                <span style="color:#E2E8F0;">Likes por Batería de Elixir</span>
                <strong id="lblPersonalTap" class="tabular" style="color:#FDA4AF;">15 ❤️</strong>
              </div>
              <input id="sliderPersonalTap" type="range" min="5" max="100" step="5" value="15" style="width:100%;" />
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:3px;">
                <span style="color:#E2E8F0;">Meta de Likes para Frenesí x2</span>
                <strong id="lblFrenzyGoal" class="tabular" style="color:#FCD34D;">100 ❤️</strong>
              </div>
              <input id="sliderFrenzyGoal" type="range" min="25" max="500" step="25" value="100" style="width:100%;" />
            </div>
            <button id="btnUnderdogTapToggle" class="btn" style="text-align:left;display:flex;justify-content:space-between;align-items:center;">
              <span>Likes sin equipo apoyan al que va perdiendo</span>
              <strong id="lblUnderdogTap" style="color:#34D399;">ON</strong>
            </button>
          </div>
          <div class="grid-3">
            <button id="btnTestTapA" class="btn btn-rose" style="font-size:9.5px;padding:6px 4px;">❤️ +15 Tap Norte</button>
            <button id="btnTestTapB" class="btn btn-rose" style="font-size:9.5px;padding:6px 4px;">❤️ +15 Tap Sur</button>
            <button onclick="activateFrenzy()" class="btn btn-amber" style="font-size:9.5px;padding:6px 4px;">⚡ Frenesí x2</button>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title">
            <span style="color:#7DD3FC;">TikFinity WebSocket (Auto-Reconnect)</span>
            <span id="wsStatus" style="color:#94A3B8;">Offline</span>
          </div>
          <div style="display:flex;gap:6px;">
            <input id="wsUrl" class="inp" type="text" value="ws://localhost:21213/" style="font-family:monospace;" />
            <button id="btnWsConnect" class="btn btn-primary" style="flex-shrink:0;">Conectar</button>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title">
            <span style="color:#FDBA74;">Torneo (King of the Hill) &amp; Presets</span>
            <button id="btnTournamentToggle" class="btn" style="padding:3px 8px;font-size:9.5px;">Torneo: ON</button>
          </div>
          <div class="grid-2" style="margin-bottom:6px;">
            <button id="btnPresetWorld" class="btn" style="font-size:9.5px;">🌎 Países (MX vs AR)</button>
            <button id="btnPresetLigaMX" class="btn btn-amber" style="font-size:9.5px;">⚽ Liga MX (🦅 vs 🐐)</button>
          </div>
          <div id="rosterChips" style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px;"></div>
          <div style="display:flex;gap:4px;">
            <input id="inAddFlag" class="inp" placeholder="🇯🇵" style="width:40px;text-align:center;" />
            <input id="inAddName" class="inp" placeholder="Nombre (ej. JAPÓN)" />
            <input id="inAddKey" class="inp" placeholder="JP" style="width:44px;text-align:center;text-transform:uppercase;" />
            <button id="btnAddRoster" class="btn btn-emerald" style="flex-shrink:0;">+ Añadir</button>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title">
            <span style="color:#FCD34D;">Gift Mapper (giftId + Alias + PNG)</span>
            <button id="btnSaveGifts" class="btn btn-emerald" style="padding:3px 8px;font-size:9.5px;">Guardar</button>
          </div>
          <div style="overflow-x:auto;">
            <table class="gm-table">
              <thead>
                <tr><th>Acción</th><th>IDs / Alias</th><th>🪙</th><th>PNG</th></tr>
              </thead>
              <tbody id="giftMapperBody"></tbody>
            </table>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title"><span>Pruebas Manuales (Atajos TikFinity)</span></div>
          <div class="grid-2">
            <button onclick="manualTestGift('A', 1)" class="btn">[1] A: Soldados</button>
            <button onclick="manualTestGift('B', 1)" class="btn">[7] B: Soldados</button>
            <button onclick="manualTestGift('A', 2)" class="btn">[2] A: Tanque</button>
            <button onclick="manualTestGift('B', 2)" class="btn">[8] B: Tanque</button>
            <button onclick="manualTestGift('A', 3)" class="btn">[3] A: Jet Furtivo</button>
            <button onclick="manualTestGift('B', 3)" class="btn">[9] B: Jet Furtivo</button>
            <button onclick="manualTestGift('A', 4)" class="btn btn-amber">[4] A: Nuclear (3s)</button>
            <button onclick="manualTestGift('B', 4)" class="btn btn-amber">[0] B: Nuclear (3s)</button>
            <button onclick="manualTestGift('A', 5)" class="btn">[5] A: Escudo +15%</button>
            <button onclick="manualTestGift('B', 5)" class="btn">[6] B: Escudo +15%</button>
            <button onclick="manualTestGift('A', 6)" class="btn btn-cyan">[Q] A: EMP (10s)</button>
            <button onclick="manualTestGift('B', 6)" class="btn btn-cyan">[E] B: EMP (10s)</button>
            <button onclick="manualTestGift('A', 7)" class="btn btn-purple">[Z] A: Cyber Hack</button>
            <button onclick="manualTestGift('B', 7)" class="btn btn-purple">[X] B: Cyber Hack</button>
            <button onclick="simulateFollowEvent()" class="btn btn-emerald">[F] ➕ Follow</button>
            <button onclick="simulateShareEvent()" class="btn btn-primary">[G] ✈️ Share (Jet)</button>
            <button onclick="triggerMeteorShower('Manual')" class="btn btn-danger" style="grid-column:span 2;">[B] ☄️ Lluvia de Meteoritos</button>
          </div>
        </div>
      </div>

      <!-- MODAL DE TELEMETRÍA (TECLA I O 📊) -->
      <div id="telemetryModal" class="modal-overlay hidden">
        <div class="modal-header">
          <div>
            <div style="font-size:13px;font-weight:900;letter-spacing:0.05em;">📊 TELEMETRÍA V2.3</div>
            <div style="font-size:9px;color:#94A3B8;margin-top:2px;">Monetización, algoritmo y estabilidad WebSocket (solo eventos reales)</div>
          </div>
          <button id="btnCloseTelemetry" class="btn">Cerrar ✕</button>
        </div>

        <div class="grid-3" style="margin-bottom:10px;">
          <div class="kpi-box"><div class="kpi-label">Duración</div><div id="telDuration" class="kpi-val tabular">00:00:00</div></div>
          <div class="kpi-box"><div class="kpi-label">Monedas Est.</div><div id="telCoins" class="kpi-val tabular" style="color:#FDE047;">0 🪙</div></div>
          <div class="kpi-box"><div class="kpi-label">Monedas/Hr</div><div id="telCoinsHr" class="kpi-val tabular" style="color:#34D399;">0</div></div>
          <div class="kpi-box"><div class="kpi-label">Regalos</div><div id="telGifts" class="kpi-val tabular">0</div></div>
          <div class="kpi-box"><div class="kpi-label">Tap Taps</div><div id="telTaps" class="kpi-val tabular" style="color:#FDA4AF;">0</div></div>
          <div class="kpi-box"><div class="kpi-label">Tap/Gift</div><div id="telRatio" class="kpi-val tabular">0:1</div></div>
          <div class="kpi-box"><div class="kpi-label">Follows</div><div id="telFollows" class="kpi-val tabular" style="color:#6EE7B7;">0</div></div>
          <div class="kpi-box"><div class="kpi-label">Shares</div><div id="telShares" class="kpi-val tabular" style="color:#7DD3FC;">0</div></div>
          <div class="kpi-box"><div class="kpi-label">Avatares LRU</div><div id="telCache" class="kpi-val tabular">0/150</div></div>
        </div>

        <div class="section-card">
          <div class="section-title"><span>Top Regalos Enviados</span></div>
          <div id="telTopGifts" style="font-size:10px;color:#CBD5E1;display:flex;flex-direction:column;gap:4px;"></div>
        </div>

        <div class="section-card">
          <div class="section-title"><span>Log WebSocket TikFinity</span></div>
          <div id="telWsLog" style="font-family:monospace;font-size:9px;color:#94A3B8;max-height:110px;overflow-y:auto;display:flex;flex-direction:column;gap:3px;"></div>
        </div>

        <div class="grid-3">
          <button id="btnExportJson" class="btn btn-primary">⬇ JSON</button>
          <button id="btnExportCsv" class="btn btn-emerald">⬇ CSV</button>
          <button id="btnTelReset" class="btn btn-danger">🗑️ Reset</button>
        </div>
      </div>

    </div> <!-- Fin #hud -->
  </div> <!-- Fin #stage -->
  </div> <!-- Fin #stageFrame -->

  <script type="module" src="/src/main.ts"></script>
</body>
</html>
