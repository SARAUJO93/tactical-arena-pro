  const msgs = [
    `1. Escribe ${state.teamA.key} o ${state.teamB.key} en chat para elegir bando`,
    `2. ❤️ ${state.personalTapThreshold} Tap Taps = +⚡ Elixir • ${state.frenzyGoalLikes} = Frenesí x2`,
