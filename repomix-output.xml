    });
    $('sliderFrenzyGoal').addEventListener('input', (e) => { state.frenzyGoalLikes = Number((e.target as HTMLInputElement).value); this.syncControlButtons(); savePersistentState(); });$('btnUnderdogTapToggle').addEventListener('click', () => {
      state.unalignedTapSupportsUnderdog = !state.unalignedTapSupportsUnderdog;
