    pill.classList.remove('sudden', 'frenzy');
    $('timerIcon').textContent = '⏱️';
    $('timerText').textContent = `${String(Math.floor(state.roundTimeLeft / 60)).padStart(2, '0')}:${String(state.roundTimeLeft % 60).padStart(2, '0')}`;
