let takeoverTimer: ReturnType<typeof setTimeout> | null = null;
const takeoverQueue: { team: TeamId; clean: string; avatarUrl: string; giftName: string }[] = [];

function endTakeovers(): void {
  if (takeoverTimer) clearTimeout(takeoverTimer);
  takeoverQueue.length = 0;
  state.takeoverActive = false;
  state.timeScale = 1.0;
  $('whaleTakeover').classList.add('hidden');
}

function runNextTakeover(): void {
  const job = takeoverQueue.shift();
  if (!job || !state.roundActive) { endTakeovers(); return; }
  const enemyObj = job.team === 'A' ? state.teamB : state.teamA;
  state.takeoverActive = true; state.timeScale = 0.25;
  synth.duck(3500); synth.playSFX('nuclear_siren');
  synth.speak(`${job.clean.replace('@', '')} lanzó ataque nuclear contra ${enemyObj.name}`);
  ($('tkAvatar') as HTMLImageElement).src = getAvatar(job.avatarUrl, job.clean).dataUrl;
  $('tkUser').textContent = job.clean;
  $('tkSub').textContent = `${job.giftName.toUpperCase()} • OBJETIVO: ${enemyObj.name}`;
  $('whaleTakeover').classList.remove('hidden');

  takeoverTimer = setTimeout(() => {
    if (state.roundActive) {
      sim.spawnOrbital(job.team, job.clean, job.avatarUrl);
      elixir.addElixir(job.team, state.frenzyActive ? 5 : 3);
    }
    if (takeoverQueue.length && state.roundActive) runNextTakeover();
    else endTakeovers();
  }, 2600);
}

bus.on('action:instant', ({ team, kind, user, avatarUrl, giftName, mult = 1 }) => {
  if (!state.roundActive) return;
  if (kind === 'SHIELD') {
    const base = team === 'A' ? state.teamA : state.teamB;
    const heal = Math.round(MAX_BASE_HP * 0.15 * mult);
    base.hp = Math.min(MAX_BASE_HP, base.hp + heal);
    base.shieldHp = 550 * mult; base.shieldTimer = 12; base.shieldOwner = user; base.shieldAvatar = avatarUrl;
    synth.duck(2000); synth.playSFX('shield');
    sim.pushShockwave(sim.safeCenterX, team === 'A' ? sim.baseAY : sim.baseBY, 72, '#22D3EE', 3);
    sim.pushBadge(sim.safeCenterX, (team === 'A' ? sim.baseAY : sim.baseBY) + (team === 'A' ? 24 : -24), `+${heal} HP 🛡️`, '#67E8F9');
    showCenterBanner('🛡️ ESCUDO + REPARACIÓN', `${user} curó +${heal} HP a ${base.name}`, '#22D3EE', avatarUrl, user);
    updateBaseHUD(); updatePanicAlerts();
  } else if (kind === 'EMP') {
    const enemyTeam: TeamId = team === 'A' ? 'B' : 'A';
    const enemyBase = enemyTeam === 'A' ? state.teamA : state.teamB;
    const dur = state.frenzyActive ? 14 : 10;
    enemyBase.empTimer = Math.min(18, enemyBase.empTimer + dur);
    sim.applyEmpToUnits(enemyTeam, dur);
    elixir.applyEmpSlow(enemyTeam, 6);
    synth.duck(2400); synth.playSFX('emp'); state.shake = Math.max(state.shake, 7);
    showCenterBanner(`⚡ PULSO EMP (${enemyBase.empTimer}s)`, `${user} apagó torretas de ${enemyBase.name}`, '#22D3EE', avatarUrl, user);
  } else if (kind === 'CYBER_HACK') {
    const maxSteal = state.frenzyActive ? 4 : 3;
    const stolen = sim.applyCyberHack(team, user, avatarUrl, maxSteal);
    const missing = Math.max(0, maxSteal - stolen);
    if (missing > 0) elixir.addElixir(team, missing * 2);
    synth.duck(2400); synth.playSFX('hack');
    const detail = missing > 0 ? `robó ${stolen} y recuperó +${missing * 2}⚡` : `robó ${stolen} unidades enemigas`;
    showCenterBanner('👾 CYBER HACK', `${user} ${detail}`, '#C084FC', avatarUrl, user);
  } else if (kind === 'NUCLEAR') {
    const clean = user.startsWith('@') ? user : `@${user}`;
    takeoverQueue.push({ team, clean, avatarUrl, giftName: giftName || 'Nuclear' });
    if (!state.takeoverActive) runNextTakeover();
  } else if (kind === 'METEOR_SHOWER') {
    state.meteorRainRemaining += 9;
    synth.duck(3000); synth.playSFX('sudden_horn');
    showCenterBanner('☄️ LLUVIA DE METEORITOS', `${user} • Impactos orbitales en zona central`, '#FB923C');
  }
});

bus.on('game:chat', ({ user, comment }) => registerChatAlignment(user, comment));

bus.on('game:tap', ({ user, count, avatarUrl, forcedTeam, isDemo = false }) => {
  if (!state.roundActive) return;
  if (!isDemo) { state.lastRealInteractionAt = Date.now(); state.telemetry.totalTaps += count; }
  const clean = (user || 'Viewer').startsWith('@') ? user : `@${user || 'Viewer'}`;
  let team = forcedTeam || state.viewerTeams.get(clean) || null;
  if (!team && state.unalignedTapSupportsUnderdog) team = state.teamA.hp <= state.teamB.hp ? 'A' : 'B';

  if (team) {
    let likes = (state.viewerLikes.get(clean) || 0) + count;
    let guard = 0;
    while (likes >= state.personalTapThreshold && guard++ < 4) {
      likes -= state.personalTapThreshold;
      elixir.addElixir(team, 0.6);
      elixir.enqueueOrder({ team, kind: 'INFANTRY', priority: 2, user: clean, avatarUrl, isTapBadge: true });
      addMVPPoints(clean, team, avatarUrl, 15, isDemo);
      synth.playSFX('tap');
    }
    state.viewerLikes.set(clean, Math.min(likes, state.personalTapThreshold * 2));
  }
  if (!state.frenzyActive) {
    state.globalTapCount += count;
    if (state.globalTapCount >= state.frenzyGoalLikes) { activateFrenzy(); return; }
  }
  updateFrenzyGaugeUI();
});

bus.on('game:follow', ({ user, avatarUrl, isDemo = false }) => {
  if (!state.roundActive) return;
  if (!isDemo) { state.lastRealInteractionAt = Date.now(); state.telemetry.totalFollows++; }
  const clean = user.startsWith('@') ? user : `@${user}`;
  const team = resolveUserTeam(clean);
  elixir.addElixir(team, 0.8);
  elixir.enqueueOrder({ team, kind: 'INFANTRY', priority: 2, user: clean, avatarUrl });
  addMVPPoints(clean, team, avatarUrl, 20, isDemo);
  showLastCommander(clean, avatarUrl, `¡siguió! → +⚡ y Soldados`, '#34D399');
  synth.playSFX('follow');
});

bus.on('game:share', ({ user, avatarUrl, isDemo = false }) => {
  if (!state.roundActive) return;
  if (!isDemo) { state.lastRealInteractionAt = Date.now(); state.telemetry.totalShares++; }
  const clean = user.startsWith('@') ? user : `@${user}`;
  const team = resolveUserTeam(clean);
  elixir.addElixir(team, 1.5);
  elixir.enqueueOrder({ team, kind: 'JET', priority: 2, user: clean, avatarUrl });
  addMVPPoints(clean, team, avatarUrl, 50, isDemo);
  showCenterBanner('✈️ ATAQUE POR COMPARTIR', `${clean} → Jet en cola para ${(team === 'A' ? state.teamA : state.teamB).name}`, '#38BDF8', avatarUrl, clean);
});

bus.on('game:gift', ({ team, tier, delta, user, giftName, avatarUrl, coins, isDemo = false }) => {
  if (!state.roundActive || delta <= 0) return;
  if (!isDemo) { state.lastRealInteractionAt = Date.now(); recordTelemetryGift(giftName, delta, coins || 1); }
  const clean = user.startsWith('@') ? user : `@${user}`;
  state.viewerTeams.set(clean, team);
  addMVPPoints(clean, team, avatarUrl, Math.max(10, (coins || 1) * 10) * delta, isDemo);

  const tObj = team === 'A' ? state.teamA : state.teamB;
  showLastCommander(clean, avatarUrl, `${delta > 1 ? `x${delta} ` : ''}${giftName}${state.frenzyActive ? ' ⚡x2' : ''}`, tObj.color);

  if (tier === 1) {
    for (let i = 0; i < delta; i++) {
      elixir.addElixir(team, 0.5);
      elixir.enqueueOrder({ team, kind: 'INFANTRY', priority: 1, user: clean, avatarUrl, isPaidGift: true });
    }
  } else if (tier === 2) {
    for (let i = 0; i < delta; i++) {
      elixir.addElixir(team, 1.0);
      elixir.enqueueOrder({ team, kind: 'TANK', priority: 1, user: clean, avatarUrl, isPaidGift: true });
    }
    synth.speak(`${clean.replace('@', '')} envió tanque para ${tObj.name}`);
  } else if (tier === 3) {
    for (let i = 0; i < delta; i++) {
      elixir.addElixir(team, 0.8);
      elixir.enqueueOrder({ team, kind: 'JET', priority: 1, user: clean, avatarUrl, isPaidGift: true });
    }
  } else if (tier === 4) {
    bus.emit('action:instant', { team, kind: 'NUCLEAR', user: clean, avatarUrl, giftName });
  } else if (tier === 5) {
    bus.emit('action:instant', { team, kind: 'SHIELD', user: clean, avatarUrl, mult: state.frenzyActive ? 2 : 1 });
  } else if (tier === 6) {
    bus.emit('action:instant', { team, kind: 'EMP', user: clean, avatarUrl });
  } else if (tier === 7) {
    bus.emit('action:instant', { team, kind: 'CYBER_HACK', user: clean, avatarUrl });
  }
});

// =========================================================================
// RELOJ, FRENESÍ, MUERTE SÚBITA, CINEMÁTICA DE VICTORIA 10s Y RESET
// =========================================================================
function activateFrenzy(): void {
  if (!state.roundActive) return;
  state.frenzyActive = true; state.frenzyTimeLeft = 20; state.globalTapCount = 0;
  $('frenzyVignette').classList.add('active');
  updateFrenzyGaugeUI();
  syncTimerPill();
  pushNotificationDock('⚡ FRENESÍ x2 ACTIVO', 'Elixir doble durante 20 segundos', '#FBBF24', '', '', '⚡', 'BOOST', 3000);
  synth.duck(2400); synth.playSFX('frenzy');
  elixir.addElixir('A', 2.5); elixir.addElixir('B', 2.5);
}

function activateSuddenDeath(): void {
  if (!state.roundActive || state.suddenDeathActive) return;
  state.suddenDeathActive = true; state.roundTimeLeft = 0;
  $('suddenDeathVignette').classList.add('active');
  syncTimerPill();
  pushNotificationDock('💀 MUERTE SÚBITA', 'Elixir x3 • Daño x2 • BPM +18%', '#ef4444', '', '', '💀', 'FINAL', 3200);
  synth.duck(2400); synth.playSFX('sudden_horn');
}

let restartTimer: ReturnType<typeof setInterval> | null = null;
let victoryOverlayTimer: ReturnType<typeof setTimeout> | null = null;

function triggerVictory(winner: TeamId): void {
  if (!state.roundActive) return;
  state.roundActive = false; state.frenzyActive = false; state.suddenDeathActive = false;
  endTakeovers();
  $('frenzyVignette').classList.remove('active'); $('suddenDeathVignette').classList.remove('active');
  $('notificationDock').classList.add('hidden');

  const winObj = winner === 'A' ? state.teamA : state.teamB;
  const loseObj = winner === 'A' ? state.teamB : state.teamA;
  winObj.wins++; winObj.streak++; loseObj.streak = 0;

  let nextChallenger: TeamPreset | null = null;
  if (state.tournamentMode && state.roster.length > 2) {
    for (let i = 0; i < state.roster.length; i++) {
      const c = state.roster[state.rosterCursor % state.roster.length];
      state.rosterCursor = (state.rosterCursor + 1) % state.roster.length;
      if (c.name !== winObj.name && c.name !== loseObj.name) {
        nextChallenger = c;
        break;
      }
    }
  }

  savePersistentState();
  state.shake = 18; state.screenFlash = 0.65;
  sim.spawnVictoryConfetti(winner);
  synth.duck(3200); synth.playSFX('orbital_boom');
  synth.speak(`Victoria para ${winObj.name}`);
  setTimeout(() => synth.playSFX('victory'), 420);

  const topRound = Object.values(state.roundMVP).sort((a, b) => b.score - a.score)[0] || { user: '@Comandante', avatarUrl: '', score: 0 };
  $('vicFlag').innerHTML = renderTeamFlagHtml(winObj.key, winObj.flag, 'hero');
  $('vicName').textContent = winObj.name;
  $('vicName').style.color = winObj.color;
  ($('vicMvpAvatar') as HTMLImageElement).src = getAvatar(topRound.avatarUrl, topRound.user).dataUrl;
  $('vicMvpUser').textContent = topRound.user;
  $('vicMvpScore').textContent = `${topRound.score.toLocaleString()} pts`;
  $('vicStreakText').classList.toggle('hidden', !(state.tournamentMode && winObj.streak >= 1));
  $('vicStreakText').textContent = `🔥 ${winObj.streak} VICTORIA${winObj.streak > 1 ? 'S' : ''} EN EL TRONO`;
  $('vicChallengerBanner').classList.toggle('hidden', !nextChallenger);
  if (nextChallenger) $('vicChallengerBanner').textContent = `⚔️ NUEVO RETADOR: ${nextChallenger.flag} ${nextChallenger.name}`;

  if (victoryOverlayTimer) clearTimeout(victoryOverlayTimer);
  victoryOverlayTimer = setTimeout(() => {
    const ov = $('victoryOverlay');
    ov.classList.remove('hidden', 'show');
    void ov.offsetWidth;
    ov.classList.add('show');
  }, 650);

  let sec = 10;
  $('vicCountdown').textContent = String(sec);
  if (restartTimer) clearInterval(restartTimer);
  restartTimer = setInterval(() => {
    sec--;
    $('vicCountdown').textContent = String(Math.max(0, sec));
    if (sec <= 0) {
      if (restartTimer) clearInterval(restartTimer);
      if (nextChallenger) {
        Object.assign(winner === 'A' ? state.teamB : state.teamA, nextChallenger, { wins: 0, streak: 0 });
        state.viewerTeams.clear();
        applyTeamUI(); savePersistentState();
      }
      resetRound();
    }
  }, 1000);
}

function resetRound(): void {
  if (restartTimer) clearInterval(restartTimer);
  if (victoryOverlayTimer) clearTimeout(victoryOverlayTimer);
  endTakeovers();
  [state.teamA, state.teamB].forEach((t) => {
    t.hp = MAX_BASE_HP; t.flash = 0; t.shieldHp = 0; t.shieldTimer = 0; t.empTimer = 0; t.panicActive = false;
  });
  state.teamA.sideDefenses = [makeSideDefenseState(true), makeSideDefenseState(true)];
  state.teamB.sideDefenses = [makeSideDefenseState(false), makeSideDefenseState(false)];

  state.roundActive = true; state.roundTimeLeft = state.suddenDeathDurationSec;
  state.suddenDeathActive = false; state.frenzyActive = false; state.frenzyTimeLeft = 0;
  state.globalTapCount = 0; state.roundMVP = {}; state.meteorRainRemaining = 0;

  sim.clearEntities();
  elixir.resetRound();
  cycleNextBiome();

  $('suddenDeathVignette').classList.remove('active'); $('frenzyVignette').classList.remove('active');
  $('victoryOverlay').classList.remove('show'); $('victoryOverlay').classList.add('hidden');
  applyTeamUI(); updateBaseHUD(); updateFrenzyGaugeUI(); syncTimerPill();
  announceActiveBiome();
}

function resetSession(): void {
  state.teamA.wins = 0; state.teamA.streak = 0;
  state.teamB.wins = 0; state.teamB.streak = 0;
  state.sessionMVP = {};
  state.viewerTeams.clear();
  state.viewerLikes.clear();
  state.nextMeteorCoinTarget = METEOR_COIN_STEP;
  state.telemetry = {
    sessionStart: Date.now(),
    totalCoins: 0, totalGifts: 0, totalTaps: 0, totalFollows: 0, totalShares: 0,
    giftBreakdown: {}, wsLog: [],
  };
  logWsEvent('Sesión y telemetría reiniciadas.');
  renderTop3MVP();
  renderTelemetry();
  savePersistentState();
  resetRound();
}

function applyTeamUI(): void {
  document.documentElement.style.setProperty('--team-a', state.teamA.color);
  document.documentElement.style.setProperty('--team-b', state.teamB.color);
  $('scoreFlagA').innerHTML = renderTeamFlagHtml(state.teamA.key, state.teamA.flag, 'inline');
  $('scoreFlagB').innerHTML = renderTeamFlagHtml(state.teamB.key, state.teamB.flag, 'inline');
  $('winsA').textContent = String(state.teamA.wins); $('winsB').textContent = String(state.teamB.wins);
  $('flagA').innerHTML = renderTeamFlagHtml(state.teamA.key, state.teamA.flag, 'inline');
  $('nameA').textContent = state.teamA.name; $('keyBadgeA').textContent = state.teamA.key;
  $('hpBarA').style.background = state.teamA.color; $('hpPctA').style.color = state.teamA.color;
  $('flagB').innerHTML = renderTeamFlagHtml(state.teamB.key, state.teamB.flag, 'inline');
  $('nameB').textContent = state.teamB.name; $('keyBadgeB').textContent = state.teamB.key;
  $('hpBarB').style.background = state.teamB.color; $('hpPctB').style.color = state.teamB.color;

  $('streakBadgeA').classList.toggle('hidden', !(state.tournamentMode && state.teamA.streak >= 1));
  $('streakBadgeA').textContent = `🔥 ${state.teamA.streak}`;
  $('streakBadgeB').classList.toggle('hidden', !(state.tournamentMode && state.teamB.streak >= 1));
  $('streakBadgeB').textContent = `🔥 ${state.teamB.streak}`;

  renderGiftLegend();
  renderTop3MVP();
  updateOnboardingTicker();
  settings.syncControlButtons();
  requestAnimationFrame(() => sim.updateGeometry());
}

// Helpers de simulación manual
const manualTestGift = (team: TeamId, tier: number) => {
  const slot = tier === 1 ? (team === 'A' ? state.giftSlots[0] : state.giftSlots[1]) : state.giftSlots.find((s) => s.tier === tier);
  bus.emit('game:gift', {
    team, tier, delta: 1, user: `@Cmd_${team}`,
    giftName: slot?.display || 'Regalo', avatarUrl: '', coins: slot?.coins || 1, isDemo: true,
  });
};
const simulateTap = (team: TeamId) => {
  bus.emit('game:tap', {
    user: team === 'A' ? '@TapNorte' : '@TapSur',
    count: state.personalTapThreshold, avatarUrl: '', forcedTeam: team, isDemo: true,
  });
};
const simulateFollow = () => bus.emit('game:follow', { user: '@FanDemo', avatarUrl: '', isDemo: true });
const simulateShare = () => bus.emit('game:share', { user: '@ShareDemo', avatarUrl: '', isDemo: true });
const triggerMeteorShower = (reason = 'Manual') => bus.emit('action:instant', { team: 'A', kind: 'METEOR_SHOWER', user: reason, avatarUrl: '' });

const w = window as unknown as Record<string, unknown>;
w.manualTestGift = manualTestGift;
w.activateFrenzy = activateFrenzy;
w.simulateFollowEvent = simulateFollow;
w.simulateShareEvent = simulateShare;
w.triggerMeteorShower = triggerMeteorShower;

const settings = new SettingsPanel({
  synth,
  tikfinity,
  applyTeamUI,
  renderGiftLegend,
  updatePanicAlerts,
  updateFrenzyGaugeUI,
  activateSuddenDeath,
  resetRound,
  resetSession,
  simulateTap,
});

initInputShortcuts({
  togglePanel: () => settings.togglePanel(),
  toggleTelemetry: () => settings.toggleTelemetry(),
  toggleSafeZones: () => settings.toggleSafeZones(),
  toggleDemoMode: () => settings.toggleDemoMode(),
  activateSuddenDeath,
  activateFrenzy,
  triggerMeteorShower: () => triggerMeteorShower('Manual'),
  simulateFollow,
  simulateShare,
  simulateTap,
  manualTestGift,
});

bus.on('tikfinity:status', ({ status, detail }) => {
  if (status === 'connected') {
    $('wsTopDot').style.background = '#34D399'; $('wsTopText').textContent = 'TikFinity ON';
    $('wsStatus').textContent = 'Conectado'; $('btnWsConnect').textContent = 'Desconectar';
    if (state.demoMode) { state.demoMode = false; settings.syncControlButtons(); }
  } else if (status === 'reconnecting') {
    $('wsTopDot').style.background = '#FBBF24'; $('wsTopText').textContent = detail || 'Reconectando';
    $('wsStatus').textContent = detail || 'Reconectando...'; $('btnWsConnect').textContent = 'Detener';
  } else {
    $('wsTopDot').style.background = '#64748B'; $('wsTopText').textContent = 'Offline';
    $('wsStatus').textContent = 'Offline'; $('btnWsConnect').textContent = 'Conectar';
  }
});

// Reloj 1s
setInterval(() => {
  if (state.telemetryOpen) renderTelemetry();
  if (!state.roundActive) return;

  if (!state.suddenDeathActive) {
    state.roundTimeLeft = Math.max(0, state.roundTimeLeft - 1);
    if (state.roundTimeLeft === 0) activateSuddenDeath();
  }
  if (state.frenzyActive) {
    state.frenzyTimeLeft = Math.max(0, state.frenzyTimeLeft - 1);
    updateFrenzyGaugeUI();
    if (state.frenzyTimeLeft === 0) {
      state.frenzyActive = false;
      $('frenzyVignette').classList.remove('active');
    }
  }
  syncTimerPill();

  (['A', 'B'] as TeamId[]).forEach((t) => {
    const b = t === 'A' ? state.teamA : state.teamB;
    const sBadge = $(`shieldBadge${t}`), eBadge = $(`empBadge${t}`), card = $(`cardBase${t}`);
    if (b.shieldTimer > 0 && b.shieldHp > 0) { b.shieldTimer--; sBadge.textContent = `🛡️ ${b.shieldTimer}s`; sBadge.classList.remove('hidden'); }
    else { b.shieldHp = 0; sBadge.classList.add('hidden'); }
    if (b.empTimer > 0) { b.empTimer--; eBadge.textContent = `⚡ EMP ${b.empTimer}s`; eBadge.classList.remove('hidden'); card.classList.add('emp-hit'); }
    else { eBadge.classList.add('hidden'); card.classList.remove('emp-hit'); }
  });
}, 1000);

// Modo Demo aislado
const DEMO_USERS: { user: string; team: TeamId }[] = [
  { user: '@CarlosMX', team: 'A' }, { user: '@Sofia_99', team: 'A' },
  { user: '@MateoAR', team: 'B' }, { user: '@KiraLive', team: 'B' },
];
setInterval(() => {
  if (!state.roundActive || !state.demoMode || state.takeoverActive) return;
  const v = DEMO_USERS[Math.floor(Math.random() * DEMO_USERS.length)];
  const r = Math.random();
  if (r < 0.35) bus.emit('game:tap', { user: v.user, count: 15, avatarUrl: '', forcedTeam: v.team, isDemo: true });
  else if (r < 0.65) bus.emit('game:gift', { team: v.team, tier: 1, delta: 2, user: v.user, giftName: 'Rose', avatarUrl: '', coins: 1, isDemo: true });
  else if (r < 0.80) bus.emit('game:gift', { team: v.team, tier: 2, delta: 1, user: v.user, giftName: 'Dona', avatarUrl: '', coins: 30, isDemo: true });
  else if (r < 0.90) bus.emit('game:gift', { team: v.team, tier: 3, delta: 1, user: v.user, giftName: 'Perfume', avatarUrl: '', coins: 20, isDemo: true });
  else if (r < 0.95) bus.emit('game:gift', { team: v.team, tier: 6, delta: 1, user: v.user, giftName: 'EMP', avatarUrl: '', coins: 100, isDemo: true });
  else bus.emit('game:gift', { team: v.team, tier: 7, delta: 1, user: v.user, giftName: 'Hack', avatarUrl: '', coins: 99, isDemo: true });
}, 1100);

// Game Loop 60 FPS determinista
let lastTime = performance.now();
function loop(now: number): void {
  const dtSec = Math.min(0.05, Math.max(0.008, (now - lastTime) / 1000));
  lastTime = now;

  elixir.update(dtSec, {
    roundActive: state.roundActive,
    roundTimeLeft: state.roundTimeLeft,
    suddenDeathActive: state.suddenDeathActive,
    frenzyActive: state.frenzyActive,
    timeScale: state.timeScale,
    aiDirectorEnabled: state.aiDirectorEnabled,
    unitCountByTeam: (t) => sim.getUnitCount(t),
    jetCountByTeam: (t) => sim.getJetCount(t),
  });
  sim.update(dtSec * 60);
  sim.render();
  requestAnimationFrame(loop);
}

// Arranque
window.addEventListener('pointerdown', () => synth.unlock(), { passive: true });
window.addEventListener('beforeunload', saveNow);
loadPersistentState();
settings.renderRosterChips();
settings.renderGiftMapperTable();
applyTeamUI();
updateBaseHUD();
syncTimerPill();
elixir.resetRound();
synth.init();
synth.applyMusicMode();
announceActiveBiome();
logWsEvent('Tactical Arena V2.3 listo.');
requestAnimationFrame(loop);
</file>

<file path="src/style.css">
:root {
  --bg-outer: #030508;
  --bg-stage: #0b1828;
  --glass-bg: rgba(14, 22, 35, 0.74);
  --glass-soft: rgba(15, 24, 38, 0.64);
  --glass-border: rgba(255, 255, 255, 0.18);
  --team-a: #10B981;
  --team-b: #38BDF8;
  --amber: #FBBF24;
  --cyan: #22D3EE;
  --purple: #C084FC;
  --rose: #FB7185;
  --text-main: #F8FAFC;
  --text-dim: #94A3B8;
}

* {
  box-sizing: border-box;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  height: 100dvh;
  background: radial-gradient(circle at 50% 22%, #0f172a 0%, #030508 78%);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, system-ui, sans-serif;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabular { font-variant-numeric: tabular-nums; }
.hidden { display: none !important; }

/* MARCO 9:16 FULL-BLEED */
#stageFrame {
  position: relative;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  max-height: 100dvh;
  max-width: 100vw;
  background: var(--bg-stage);
  overflow: hidden;
}

@media (min-aspect-ratio: 9/16) {
  #stageFrame {
    width: auto;
    aspect-ratio: 9 / 16;
    height: 100vh;
    height: 100dvh;
  }
}

#stage {
  position: absolute;
  left: 0;
  top: 0;
  width: 390px;
  height: 693px;
  transform-origin: 0 0;
  background: var(--bg-stage);
  overflow: hidden;
}

#arenaCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: block;
}

/* VIÑETAS DE URGENCIA */
@keyframes suddenDeathPulse {
  0%, 100% { box-shadow: inset 0 0 38px rgba(239, 68, 68, 0.30); }
  50% { box-shadow: inset 0 0 96px rgba(239, 68, 68, 0.82); }
}
@keyframes frenzyGlow {
  0%, 100% { box-shadow: inset 0 0 28px rgba(251, 191, 36, 0.18); }
  50% { box-shadow: inset 0 0 68px rgba(251, 191, 36, 0.45); }
}
#frenzyVignette, #suddenDeathVignette {
  position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.35s ease;
}
#frenzyVignette { z-index: 3; }
#frenzyVignette.active { opacity: 1; animation: frenzyGlow 1.1s ease-in-out infinite; }
#suddenDeathVignette { z-index: 4; }
#suddenDeathVignette.active { opacity: 1; animation: suddenDeathPulse 0.85s ease-in-out infinite; }

/* WHALE TAKEOVER */
@keyframes takeoverIn {
  0% { opacity: 0; transform: scale(0.86); }
  18% { opacity: 1; transform: scale(1.02); }
  100% { opacity: 1; transform: scale(1); }
}
#whaleTakeover {
  position: absolute;
  inset: 0;
  z-index: 28;
  background: radial-gradient(circle at 44% 44%, rgba(251, 191, 36, 0.22) 0%, rgba(3, 6, 14, 0.82) 68%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14% 14% 28% 4%;
  pointer-events: none;
}
.takeover-card {
  width: 100%;
  max-width: 270px;
  background: rgba(10, 14, 24, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1.5px solid rgba(251, 191, 36, 0.78);
  border-radius: 22px;
  padding: 16px 14px;
  text-align: center;
  box-shadow: 0 0 60px rgba(251, 191, 36, 0.38), inset 0 0 24px rgba(251, 191, 36, 0.14);
  animation: takeoverIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* HUD */
#hud {
  position: absolute;
  inset: 0;
  z-index: 10;
  background: transparent !important;
  pointer-events: none;
}

.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border: 1px solid var(--glass-border);
}
.glass-soft {
  background: var(--glass-soft);
  backdrop-filter: blur(12px) saturate(135%);
  -webkit-backdrop-filter: blur(12px) saturate(135%);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

/* BARRA SUPERIOR (En zona de controles superiores 10% para OBS/Streamer) */
#topUtilBar {
  position: absolute;
  top: 6px;
  left: 8px;
  right: 8px;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}
.util-group { display: flex; align-items: center; gap: 4px; pointer-events: auto; }
.util-btn {
  height: 25px;
  padding: 0 8px;
  border-radius: 999px;
  font-size: 8.5px;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #E2E8F0;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  pointer-events: auto;
  transition: background 0.15s, transform 0.1s;
}
.util-btn:hover { background: rgba(255, 255, 255, 0.18); }
.util-btn:active { transform: scale(0.95); }
.util-icon { width: 25px; padding: 0; font-size: 11.5px; }

@keyframes obsPulse {
  0%, 100% { transform: translateX(-50%) scale(1); box-shadow: 0 0 14px rgba(251, 191, 36, 0.42); }
  50% { transform: translateX(-50%) scale(1.04); box-shadow: 0 0 26px rgba(251, 191, 36, 0.8); }
}
#obsAudioUnlock {
  position: absolute;
  top: 36px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  padding: 5px 12px;
  border-radius: 999px;
  background: rgba(251, 191, 36, 0.96);
  color: #0F172A;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
  white-space: nowrap;
  border: 1px solid #FEF3C7;
  pointer-events: auto;
  animation: obsPulse 1.4s ease-in-out infinite;
}

/* NOTIFICATION DOCK ÚNICO (Superpuesto sobre #onboardingTicker en top: 10.4%) */
#notificationDock {
  position: absolute;
  top: 10.4%;
  left: 3%;
  right: 13%;
  height: 22px;
  z-index: 27;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2px 8px 3px;
  overflow: hidden;
  pointer-events: none;
  color: #f8fbff;
  background: rgba(10, 24, 40, 0.96);
  border: 1px solid rgba(175, 211, 236, 0.34);
  border-left: 3px solid var(--notification-accent, #5ac8fa);
  border-radius: 9px;
  box-shadow: 0 5px 14px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.notification-visual {
  width: 16px; height: 16px; flex: 0 0 16px; display: grid; place-items: center;
  border-radius: 50%; background: rgba(255, 255, 255, 0.09); font-size: 10px; overflow: hidden;
}
#notificationAvatar { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.notification-copy { flex: 1 1 auto; min-width: 0; overflow: hidden; }
.notification-line { display: flex; align-items: baseline; gap: 5px; white-space: nowrap; overflow: hidden; }
#notificationTitle { color: #ffd166; font-size: 7.2px; font-weight: 800; max-width: 48%; overflow: hidden; text-overflow: ellipsis; }
#notificationSub { color: rgba(245, 249, 255, 0.9); font-size: 7px; overflow: hidden; text-overflow: ellipsis; }
#notificationTag { color: #a9bfd1; font-size: 5.5px; font-weight: 800; letter-spacing: 0.12em; padding-left: 5px; border-left: 1px solid rgba(255, 255, 255, 0.16); }
.notification-progress {
  position: absolute; left: 0; bottom: 0; height: 2px; width: 100%;
  background: var(--notification-accent, #5ac8fa); transform-origin: left center;
}
#notificationDock.dock-progress-run .notification-progress {
  animation: dockDrain var(--notification-duration, 2600ms) linear forwards;
}
@keyframes dockDrain { to { transform: scaleX(0); } }

/* SAFE ZONES TIKTOK */
#safeZoneGuide { position: absolute; inset: 0; z-index: 25; pointer-events: none; }
.sz-band {
  position: absolute;
  background: rgba(239, 68, 68, 0.24);
  border-color: rgba(248, 113, 113, 0.78);
  display: flex; align-items: center; justify-content: center;
  font-size: 8px; font-weight: 800; letter-spacing: 0.12em;
  text-transform: uppercase; color: #FECACA; text-align: center;
}

/* ZONA SEGURA MAXIMIZADA */
#safeZoneHUD {
  position: absolute;
  top: 10.4%;
  bottom: 14%;
  left: 3%;
  right: 13%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 5px 4px;
  pointer-events: none;
}

#onboardingTicker {
  width: 100%;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  padding: 0 8px;
  text-align: center;
  font-size: 8.2px;
  font-weight: 700;
  color: #E2E8F0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-meta-row { display: flex; align-items: center; gap: 4px; width: 100%; }
.score-pill, .timer-pill {
  padding: 3px 6px;
  border-radius: 10px;
  display: flex; align-items: center; gap: 3px;
  flex-shrink: 0;
  font-size: 10px; font-weight: 800;
}
.timer-pill.frenzy {
  background: rgba(245, 158, 11, 0.92);
  border-color: #FEF08A;
  color: #0F172A;
}
.timer-pill.sudden {
  background: rgba(153, 27, 27, 0.92);
  border-color: rgba(248, 113, 113, 0.85);
  color: #FFFFFF;
}
#mvpStrip {
  flex: 1; min-width: 0; border-radius: 10px; padding: 2px 4px;
  display: flex; align-items: center; gap: 3px; overflow: hidden;
}
.mvp-item {
  flex: 1; min-width: 0; display: flex; align-items: center; gap: 4px;
  background: rgba(255, 255, 255, 0.06); border-radius: 7px; padding: 2px 3px; overflow: hidden;
}

/* TARJETAS DE BASE + BARRA DE ELIXIR (Compactadas para maximizar arena) */
.base-card { border-radius: 10px; padding: 3px 8px; transition: border-color 0.25s, box-shadow 0.25s; }
.base-card.panic { border-color: rgba(239, 68, 68, 0.92); box-shadow: 0 0 18px rgba(239, 68, 68, 0.44); }
.base-card.emp-hit { border-color: rgba(34, 211, 238, 0.95); box-shadow: 0 0 18px rgba(34, 211, 238, 0.45); }
.base-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; gap: 4px; }
.base-id { display: flex; align-items: center; gap: 4px; min-width: 0; overflow: hidden; }
.base-name { font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tag-pill { font-size: 7px; font-weight: 800; padding: 1px 4px; border-radius: 5px; background: rgba(255,255,255,0.12); color: #E2E8F0; text-transform: uppercase; flex-shrink: 0; }
.streak-pill { background: rgba(249, 115, 22, 0.28); border: 1px solid rgba(251, 146, 60, 0.6); color: #FED7AA; }
.shield-pill { background: rgba(34, 211, 238, 0.25); border: 1px solid rgba(103, 232, 249, 0.6); color: #CFFAFE; }
.emp-pill { background: rgba(6, 182, 212, 0.30); border: 1px solid #67E8F9; color: #ECFEFF; }
.hp-track { width: 100%; height: 5.5px; background: rgba(255, 255, 255, 0.14); border-radius: 999px; overflow: hidden; position: relative; }
.hp-trail { position: absolute; inset: 0 auto 0 0; background: rgba(255, 255, 255, 0.42); border-radius: 999px; transition: width 0.45s ease-out; }
.hp-fill { position: absolute; inset: 0 auto 0 0; border-radius: 999px; transition: width 0.15s ease-out; }

.elixir-row { display: flex; align-items: center; gap: 5px; margin-top: 3px; }
.elixir-track {
  position: relative; flex: 1; height: 5px;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(192, 132, 252, 0.28);
  border-radius: 999px; overflow: hidden;
}
.elixir-fill {
  position: absolute; inset: 0 auto 0 0;
  background: linear-gradient(90deg, #9333EA 0%, #D946EF 60%, #F0ABFC 100%);
  box-shadow: 0 0 8px rgba(217, 70, 239, 0.65);
  transition: width 0.08s linear;
}
.elixir-ticks { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(10, 1fr); pointer-events: none; }
.elixir-ticks span { border-right: 1px solid rgba(3, 5, 8, 0.65); }
.elixir-ticks span:last-child { border-right: none; }
.elixir-badge { font-size: 8px; font-weight: 800; color: #F0ABFC; min-width: 28px; text-align: right; }
.queue-badge {
  font-size: 7.5px; font-weight: 800; padding: 1px 4px; border-radius: 4px;
  background: rgba(251, 191, 36, 0.2); border: 1px solid rgba(251, 191, 36, 0.45); color: #FDE68A;
}

/* ZONA CENTRAL 100% LIBRE */
#centerArenaHUD {
  flex: 1;
  pointer-events: none;
}

/* BARRA HORIZONTAL COMPACTA DE FRENESÍ */
#frenzyStrip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2.5px 7px;
  border-radius: 8px;
}
.frenzy-strip-label {
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: #FCD34D;
  white-space: nowrap;
}
.frenzy-h-track {
  flex: 1;
  height: 5px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.14);
  overflow: hidden;
}
#frenzyGaugeFill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #F43F5E 0%, #F97316 55%, #FBBF24 100%);
  transition: width 0.2s ease-out;
}
.frenzy-strip-pct {
  font-size: 7.5px;
  font-weight: 800;
  color: #FDE047;
  min-width: 22px;
  text-align: right;
}
.frenzy-strip-count {
  font-size: 7px;
  font-weight: 700;
  color: #CBD5E1;
  white-space: nowrap;
}
.frenzy-strip-rule {
  font-size: 6.8px;
  font-weight: 800;
  color: #FDA4AF;
  padding-left: 5px;
  border-left: 1px solid rgba(255, 255, 255, 0.14);
  white-space: nowrap;
}

/* LEYENDA DE REGALOS ULTRACOMPACTA */
#giftLegendBox { border-radius: 10px; padding: 3px; }
.gift-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2.5px; }
.gift-cell {
  min-width: 0; min-height: 32px;
  display: grid; grid-template-columns: 13px minmax(0, 1fr); grid-template-rows: 1fr auto;
  align-items: center; gap: 0 3px; padding: 2px 3px;
  border-radius: 7px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);
  text-align: left; overflow: hidden;
}
.gift-cell.emp-cell { background: rgba(34, 211, 238, 0.14); border-color: rgba(34, 211, 238, 0.32); }
.gift-cell.hack-cell { background: rgba(192, 132, 252, 0.15); border-color: rgba(192, 132, 252, 0.34); }
.gift-cell.nuke-cell { background: rgba(251, 191, 36, 0.16); border-color: rgba(251, 191, 36, 0.36); }
.gift-icon-wrap { grid-column: 1; grid-row: 1 / span 2; width: 13px; height: 13px; display: flex; align-items: center; justify-content: center; font-size: 10px; }
.gift-icon-wrap img { width: 13px; height: 13px; object-fit: contain; border-radius: 3px; }
.gift-title { grid-column: 2; grid-row: 1; margin: 0; font-size: 6.2px; font-weight: 800; color: #F8FAFC; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gift-sub { display: none; }
.coin-badge { grid-column: 2; grid-row: 2; margin: 0; font-size: 5.8px; font-weight: 800; color: #FDE047; white-space: nowrap; }

/* BANDERAS SVG */
.team-flag-svg { display: block; overflow: hidden; border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.75); }
.team-flag-hero { width: 100%; height: 100%; border-width: 2px; border-radius: 8px; }
.team-flag-inline { display: inline-block; width: 16px; height: 11px; vertical-align: -1px; }
.team-flag-fallback.team-flag-hero { font-size: 62px; line-height: 1; }
.team-flag-fallback.team-flag-inline { font-size: 13px; line-height: 1; }

/* CINEMÁTICA DE VICTORIA · 10 SEGUNDOS */
#victoryOverlay {
  position: absolute; inset: 0; z-index: 42;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  padding: 24px 18px 34px; color: #fff; text-align: center; pointer-events: auto;
  background: radial-gradient(ellipse at 50% 37%, rgba(42, 84, 133, 0.96) 0%, rgba(10, 25, 49, 0.98) 52%, rgba(4, 10, 24, 0.99) 100%);
}
.vic-rays {
  position: absolute; inset: -50%; opacity: 0.25; pointer-events: none;
  background: repeating-conic-gradient(from 0deg at 50% 45%, rgba(255, 214, 122, 0.22) 0deg 5deg, transparent 5deg 15deg);
  animation: vicSpin 24s linear infinite;
}
.vic-cinematic-content { position: relative; z-index: 2; width: min(100%, 330px); display: flex; flex-direction: column; align-items: center; }
.vic-kicker { color: #b8d1e9; font-size: 8px; font-weight: 800; letter-spacing: 0.24em; }
.vic-crown { color: #ffd77c; font-size: 28px; line-height: 1; margin: 2px 0 4px; }
.vic-flag-shell { width: 120px; height: 84px; display: flex; align-items: center; justify-content: center; margin: 2px auto 4px; }
#vicFlag { width: 120px; height: 80px; display: flex; align-items: center; justify-content: center; }
.vic-title { color: #ffe3a2; font-size: 30px; font-weight: 900; letter-spacing: 0.04em; margin: 4px 0 2px; }
.vic-subtitle { color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 0.2em; margin-bottom: 4px; }
#vicName { font-size: 15px; font-weight: 900; text-transform: uppercase; margin-bottom: 6px; }
.vic-streak { color: #ffd27b; font-size: 9px; font-weight: 800; margin-bottom: 8px; }
.vic-mvp-card {
  width: min(100%, 258px); display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 9px 12px; border-radius: 15px; background: rgba(255, 255, 255, 0.11);
  border: 1px solid rgba(255, 221, 159, 0.34); margin-bottom: 8px;
}
.vic-mvp-card img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #ffd77c; flex-shrink: 0; }
.vic-mvp-label { color: #ffd77c; font-size: 7px; font-weight: 900; letter-spacing: 0.14em; }
#vicMvpUser { color: #fff; font-size: 11px; font-weight: 800; }
#vicMvpScore { color: #c5d8ea; font-size: 8px; }
.vic-challenger { margin-bottom: 8px; padding: 5px 12px; border: 1px solid rgba(125, 211, 252, 0.5); background: rgba(14, 116, 144, 0.25); border-radius: 999px; color: #c5f1ff; font-size: 8px; font-weight: 800; }
.vic-countdown-label { color: #c9d8e8; font-size: 8px; font-weight: 800; letter-spacing: 0.15em; }
#vicCountdown { color: #ffe09b; font-size: 14px; }
.vic-progress { width: min(100%, 250px); height: 4px; border-radius: 99px; overflow: hidden; margin-top: 7px; background: rgba(255, 255, 255, 0.17); }
.vic-progress-fill { display: block; height: 100%; width: 100%; transform-origin: left center; background: linear-gradient(90deg, #9edaff, #ffe09b, #fff); }
#victoryOverlay.show .vic-progress-fill { animation: vicDrain 10s linear forwards; }
.vic-thanks { color: rgba(210, 227, 245, 0.6); font-size: 6.5px; font-weight: 700; letter-spacing: 0.21em; margin-top: 10px; }
.vic-spark { position: absolute; color: #ffe4a4; font-size: 20px; pointer-events: none; }
.vic-spark-a { top: 17%; left: 12%; } .vic-spark-b { top: 30%; right: 12%; } .vic-spark-c { bottom: 20%; left: 18%; }
@keyframes vicSpin { to { transform: rotate(360deg); } }
@keyframes vicDrain { from { transform: scaleX(1); } to { transform: scaleX(0); } }

/* MODALES (AJUSTES Y TELEMETRÍA) */
.modal-overlay {
  position: absolute; inset: 0; z-index: 45;
  background: rgba(6, 9, 17, 0.97);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  padding: 14px; overflow-y: auto; pointer-events: auto;
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.section-card {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 14px; padding: 10px; margin-bottom: 10px;
}
.section-title {
  font-size: 9.5px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  color: #94A3B8; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between;
}
.btn {
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.07);
  color: #F8FAFC; border-radius: 10px; padding: 7px 10px;
  font-size: 10.5px; font-weight: 700; cursor: pointer; transition: background 0.15s;
}
.btn:hover { background: rgba(255, 255, 255, 0.15); }
.btn-primary { background: #0284C7; border-color: #38BDF8; }
.btn-emerald { background: #059669; border-color: #34D399; }
.btn-amber { background: rgba(245, 158, 11, 0.24); border-color: rgba(251, 191, 36, 0.48); color: #FDE68A; }
.btn-purple { background: rgba(147, 51, 234, 0.28); border-color: rgba(192, 132, 252, 0.55); color: #E9D5FF; }
.btn-cyan { background: rgba(8, 145, 178, 0.28); border-color: rgba(34, 211, 238, 0.55); color: #CFFAFE; }
.btn-rose { background: rgba(225, 29, 72, 0.28); border-color: rgba(251, 113, 133, 0.52); color: #FFE4E6; }
.btn-danger { background: rgba(225, 29, 72, 0.26); border-color: rgba(251, 113, 133, 0.48); color: #FECDD3; }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.inp, .sel {
  width: 100%; background: rgba(0, 0, 0, 0.55); border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 8px; padding: 5px 7px; color: #F8FAFC; font-size: 10.5px; font-family: inherit;
}
.inp:focus, .sel:focus { outline: none; border-color: #38BDF8; }

.gm-table { width: 100%; border-collapse: collapse; font-size: 9.5px; }
.gm-table th { text-align: left; color: #94A3B8; font-weight: 700; padding: 4px 3px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.gm-table td { padding: 5px 2px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }

.kpi-box { background: rgba(0,0,0,0.38); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 8px; }
.kpi-label { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94A3B8; }
.kpi-val { font-size: 14px; font-weight: 800; color: #F8FAFC; margin-top: 2px; }

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.22); border-radius: 99px; }
